---
import type { Project } from '../data/projects';
import { withBase } from '../utils/paths';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const firstMetric = project.metrics?.[0];
const artClasses = ['project-card__art', project.image && 'project-card__art--photo', project.image && (project.imageFit === 'contain' || project.category === 'Analytics') && 'project-card__art--contain'];
---

<article class="project-card" data-category={project.category}>
  <a class="project-card__link" href={withBase(`/work/${project.slug}/`)} aria-label={`View case study: ${project.title}`}>
    <div class:list={artClasses}>
      {project.galleryImages?.length ? (
        <div class:list={['project-card__gallery', project.galleryImages.length === 1 && 'project-card__gallery--single']}>
          {project.galleryImages.map((image) => (
            <div class="project-card__gallery-item">
              <img src={withBase(image.src)} alt={image.alt} loading="lazy" decoding="async" width={image.width} height={image.height} />
            </div>
          ))}
          {project.image && (
            <div class="project-card__site-preview">
              <img src={withBase(project.image)} alt={project.imageAlt ?? ''} loading="lazy" decoding="async" width={project.imageWidth ?? 1200} height={project.imageHeight ?? 800} />
              <span>Website preview</span>
            </div>
          )}
        </div>
      ) : project.image ? (
        <img src={withBase(project.image)} alt={project.imageAlt ?? ''} loading="lazy" decoding="async" width={project.imageWidth ?? 1200} height={project.imageHeight ?? 800} />
      ) : firstMetric ? (
        <div class="project-card__metric" aria-label={`Selected project metric: ${firstMetric.value} ${firstMetric.label}`}>
          <span class="project-card__metric-label">SELECTED FINDING</span>
          <strong>{firstMetric.value}</strong>
          <span>{firstMetric.label}</span>
          <i aria-hidden="true"></i>
        </div>
      ) : (
        <div class="project-card__index" aria-hidden="true">
          <span>{project.image ? project.category : 'PREVIEW NOT AVAILABLE'}</span>
          <strong>{project.title}</strong>
          <span>{project.category} <b>+&nbsp; EXPLORE</b></span>
        </div>
      )}
      <span class="project-card__arrow" aria-hidden="true">&#8599;</span>
    </div>
    <div class="project-card__copy">
      <div class="project-card__meta"><span>{project.category}</span><span>{project.type}</span></div>
      <h3>{project.title}</h3>
      <p>{project.summary}</p>
      <span class="text-link">View case study <span aria-hidden="true">&#8594;</span></span>
    </div>
  </a>
  {project.externalUrl && (
    <a class="project-card__external" href={project.externalUrl} target="_blank" rel="noopener noreferrer">
      {project.externalLinkLabel} <span aria-hidden="true">&#8599;</span>
    </a>
  )}
</article>