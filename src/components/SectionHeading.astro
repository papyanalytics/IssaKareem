---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  light?: boolean;
}

const { eyebrow, title, description, light = false } = Astro.props;
const titleId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<div class:list={['section-heading', light && 'section-heading--light']}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={titleId}>{title}</h2>
  {description && <p class="section-heading__description">{description}</p>}
</div>